# Normalize line endings in the repo; check out per-platform where it matters.
* text=auto

*.sh  text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf

# Binary artifacts (belt-and-braces; these are gitignored anyway)
*.png binary
*.jpg binary
*.gif binary
*.pt binary
*.pth binary
*.ckpt binary
*.safetensors binary
*.onnx binary
*.npy binary
*.npz binary
